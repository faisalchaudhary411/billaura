{
  "name": "billaura-desktop",
  "productName": "Billaura",
  "version": "1.0.0",
  "description": "Billaura – Smart Billing & Business (desktop)",
  "author": "Billaura",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.billaura.desktop",
    "productName": "Billaura",
    "directories": { "output": "dist" },
    "files": ["main.js", "app/**/*", "build/icon.png"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Billaura" },
    "artifactName": "Billaura-${version}-${arch}.${ext}"
  }
}
